# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects secrets from user settings.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL & Auth Credentials:
# Provide your Supabase project URL and public anon key to connect real Supabase tables and RLS.
# If omitted, Healno operates securely in local persistent storage mode.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
