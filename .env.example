# OPENROUTER_API_KEY: Required for OpenRouter AI API calls.
# AI Studio automatically injects secrets from user settings.
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# OPENROUTER_MODEL: The AI model ID to use on OpenRouter (e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet).
OPENROUTER_MODEL="openai/gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL & Auth Credentials:
# Provide your Supabase project URL and public anon key to connect real Supabase tables and RLS.
# If omitted, Healno operates securely in local persistent storage mode.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
